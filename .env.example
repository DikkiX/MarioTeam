OPENAI_API_KEY=
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Chat worker (beveiliging endpoint /api/chat/worker)
CHAT_WORKER_SECRET=

# Wachtrij: oude rijen automatisch op error (seconden). Optioneel.
# Default in code: pending 1800 (30 min), processing 600 (10 min).
CHAT_QUEUE_PENDING_TTL_SECONDS=1800
CHAT_QUEUE_PROCESSING_TTL_SECONDS=600

# Chat model: 1=gpt-5.2, 2=gpt-5-mini, 3=gpt-4.1-mini
CHAT_MODEL_MODE=2

# E-mail dashboard
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_WORKER_SECRET=
EMAIL_DASHBOARD_USER=
EMAIL_DASHBOARD_PASS=

OPENAI_API_KEY=
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Chat worker (beveiliging endpoint /api/chat/worker)
CHAT_WORKER_SECRET=

# Chat-wachtrij: hoe lang een rij in de DB mag blijven (seconden), daarna status error.
# WACHT = status pending (wacht op worker). VERWERK = status processing (worker bezig).
CHAT_WACHT_MAX_SECONDEN=1800
CHAT_VERWERK_MAX_SECONDEN=600

# Chat model: 1=gpt-5.2, 2=gpt-5-mini, 3=gpt-4.1-mini
CHAT_MODEL_MODE=2

# Track & trace (tool zoek_traceer) — live status PostNL / GLS
POSTNL_API_KEY=
POSTNL_CUSTOMER_CODE=
POSTNL_CUSTOMER_NUMBER=
# Optioneel: POSTNL_USE_SANDBOX=1 voor api-sandbox.postnl.nl (alleen test)
# POSTNL_USE_SANDBOX=
# POSTNL_API_BASE=

# GLS NL (gls-api.php): subscription key + MyGLS login — primair voor labels
GLS_API_KEY=
GLS_API_USER=
GLS_API_PASS=
# Optioneel: bearer token dat GLS meestuurt bij webhook-posts (stel in via api-portal.gls.nl)
GLS_WEBHOOK_SECRET=

# E-mail dashboard
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_WORKER_SECRET=
EMAIL_DASHBOARD_USER=
EMAIL_DASHBOARD_PASS=
